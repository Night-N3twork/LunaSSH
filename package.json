{
  "name": "@nightnetwork/lunassh",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Browser-native SSH over Wisp and MoonBeam.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.cjs.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs.js"
    },
    "./dusk": {
      "types": "./dist/dusk.d.ts",
      "import": "./dist/dusk.mjs",
      "require": "./dist/dusk.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.cjs.js",
    "dist/index.mjs",
    "dist/index.d.ts",
    "dist/next.cjs.js",
    "dist/next.mjs",
    "dist/next.d.ts",
    "dist/vite.cjs.js",
    "dist/vite.mjs",
    "dist/vite.d.ts",
    "dist/react.cjs.js",
    "dist/react.mjs",
    "dist/react.d.ts",
    "dist/dusk.cjs.js",
    "dist/dusk.mjs",
    "dist/dusk.d.ts",
    "dist/client.d.ts",
    "dist/bridge.d.ts",
    "dist/wisp-transport.d.ts",
    "dist/moonbeam-transport.d.ts",
    "dist/moonscale-transport.d.ts",
    "dist/provider-transport.d.ts",
    "dist/ssh-wisp-client.d.ts",
    "dist/lunassh.wasm",
    "dist/wasm_exec.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "make build",
    "build:wasm:dev": "make build",
    "build:wasm:release": "make build",
    "build:ts": "vite build",
    "build": "pnpm run build:wasm && pnpm run build:ts && node scripts/prepare-package-assets.mjs",
    "build:dev": "pnpm run build:wasm:dev",
    "build:release": "pnpm run build:wasm:release",
    "clean": "rm -rf dist/",
    "prepack": "pnpm run build && pnpm run verify:package",
    "prepublishOnly": "pnpm run verify:package",
    "test": "vitest",
    "test:run": "vitest run",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:pack": "npm pack --dry-run --json --ignore-scripts",
    "dev": "pnpm build:dev && vite",
    "dev:vite": "vite"
  },
  "keywords": [
    "ssh",
    "wasm",
    "webassembly",
    "browser",
    "client",
    "websocket",
    "wisp",
    "moonbeam",
    "packet",
    "lunassh"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Night-N3twork/LunaSSH.git"
  },
  "devDependencies": {
    "@nightnetwork/dusk": "^0.9.0",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "optionalDependencies": {
    "@nightnetwork/moonbeam": "^1.0.1"
  },
  "peerDependencies": {
    "@nightnetwork/dusk": "^0.9.0 || ^1.0.0",
    "react": ">=18.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@nightnetwork/dusk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "validator@<13.15.20": ">=13.15.20",
      "axios@>=1.0.0 <1.12.0": ">=1.12.0",
      "tar@<=7.5.3": ">=7.5.4",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "tar@<7.5.7": ">=7.5.7",
      "validator@<13.15.22": ">=13.15.22",
      "js-yaml@<3.14.2": ">=3.14.2",
      "markdown-it@>=13.0.0 <14.1.1": ">=14.1.1",
      "axios@>=1.0.0 <=1.13.4": ">=1.13.5",
      "tar@<=7.5.2": ">=7.5.3",
      "tar@<7.5.8": ">=7.5.8",
      "ajv@<6.14.0": ">=6.14.0",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=5.0.0 <5.1.7": ">=5.1.7",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6"
    }
  }
}
